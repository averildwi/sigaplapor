DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"
PORT="3000"
NODE_ENV="development"
# Comma-separated origins. Empty means no cross-origin access, never '*'.
FRONTEND_URL=""
# HS256 needs at least 256 bits of key material.
JWT_SECRET="5fbc93007905cd5fbc333cdc51813779a499b8ae411263213480cbcf76fcadf6"
JWT_EXPIRES_IN="7d"
# Number of reverse proxies in front of the app (0 = exposed directly).
TRUST_PROXY_HOPS="0"

# OTP sender adapter: 'console' prints locally, 'resend' uses the Resend API.
OTP_SENDER="console"
OTP_TTL_MINUTES="10"
OTP_RESEND_COOLDOWN_SECONDS="60"
MAX_OTP_ATTEMPTS="5"
# Both are required when OTP_SENDER=resend.
RESEND_API_KEY=""
MAIL_FROM=""

# Requests per minute per tier (BR-133): global / auth endpoints / resend-otp.
THROTTLE_DEFAULT_LIMIT="100"
THROTTLE_AUTH_LIMIT="5"
THROTTLE_SEND_CODE_LIMIT="3"

# Cloudinary signed upload targets.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="sigap-lapor"

# Kota Malang bounding box placeholders - verify visually on a Leaflet plot.
MALANG_MIN_LAT="-8"
MALANG_MAX_LAT="-7.85"
MALANG_MIN_LNG="112.55"
MALANG_MAX_LNG="112.82"

# Escalation cron (BR-128).
ESCALATION_CRON_MINUTES="15"
ESCALATION_STEP_2_DAYS="2"
